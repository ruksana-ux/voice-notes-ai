# Deepgram API Credentials
# Replace with your actual Deepgram API key (https://console.deepgram.com)
DEEPGRAM_API_KEY=your_deepgram_api_key_here
DEEPGRAM_MODEL=nova-3

# Optional: Add LLM API key for enhanced action-item extraction (Gemini / Groq / OpenAI)
# GEMINI_API_KEY=your_gemini_api_key_here
# GROQ_API_KEY=your_groq_api_key_here

# Backend Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Backend API URL (used by Streamlit frontend)
BACKEND_API_URL=http://127.0.0.1:8000
